% Lrssn Shore and Lrssn Hearth for LaTeX.
% Generated by scripts/build.py from palette/. Do not edit.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lrssntheme}[2026-10-23 v1.0.0 Lrssn Shore and Hearth colours]

% Options.
\newif\iflrssntheme@hearth
\DeclareOption{shore}{\lrssntheme@hearthfalse}
\DeclareOption{hearth}{\lrssntheme@hearthtrue}
\newif\iflrssntheme@listings
\lrssntheme@listingstrue
\DeclareOption{nolistings}{\lrssntheme@listingsfalse}
\ProcessOptions\relax

% Dependencies.
\RequirePackage{xcolor}

% Defines a colour from its HEX value in Shore (#2) and in Hearth (#3).
\newcommand*{\lrssntheme@color}[3]{%
    \iflrssntheme@hearth
        \definecolor{#1}{HTML}{#3}%
    \else
        \definecolor{#1}{HTML}{#2}%
    \fi
}

% The page.
\lrssntheme@color{LrssnBackground}{FDF6EA}{1A1512}
% Boxes and panels.
\lrssntheme@color{LrssnSurface}{F5EAD7}{15110F}
% Behind code.
\lrssntheme@color{LrssnCode}{F8EEDD}{211A16}
% Rules and frames.
\lrssntheme@color{LrssnRule}{E3D3B9}{2E343C}
% Text.
\lrssntheme@color{LrssnText}{13303D}{F0E3D0}
% Secondary text, such as captions.
\lrssntheme@color{LrssnMuted}{4F6470}{A3AEBB}
% Comments and line numbers in code.
\lrssntheme@color{LrssnComment}{76664E}{8796AA}
% The brand orange: fills and rules, never text.
\lrssntheme@color{LrssnPrimary}{FC6600}{FC6600}
% Orange text and links.
\lrssntheme@color{LrssnPrimaryText}{B04600}{FF8A3D}
% A tint behind highlighted text.
\lrssntheme@color{LrssnPrimarySoft}{FFE3CC}{3A1F0E}
% Text on an orange fill.
\lrssntheme@color{LrssnOnPrimary}{14171C}{14171C}
% The cool accent: fills and rules, never text.
\lrssntheme@color{LrssnSecondary}{00999A}{4D94B8}
% Text in the cool accent.
\lrssntheme@color{LrssnSecondaryText}{00737A}{8CC8E3}
% A tint behind secondary text.
\lrssntheme@color{LrssnSecondarySoft}{D2F1EE}{142430}
% Keywords in code.
\lrssntheme@color{LrssnKeyword}{B04600}{FC6600}
% Functions in code.
\lrssntheme@color{LrssnFunction}{00629C}{FFB547}
% Strings in code.
\lrssntheme@color{LrssnString}{00756A}{A9D48F}
% Numbers and constants in code.
\lrssntheme@color{LrssnNumber}{C2215A}{FF88C8}
% Types in code.
\lrssntheme@color{LrssnType}{3550B0}{7FCBE6}
% Built-ins in code.
\lrssntheme@color{LrssnBuiltin}{8A3FBF}{C4A5FF}
% Errors and danger.
\lrssntheme@color{LrssnError}{C4262E}{FF6B5E}
% Warnings.
\lrssntheme@color{LrssnWarning}{965A00}{FFB547}
% Success.
\lrssntheme@color{LrssnSuccess}{1C7448}{A9D48F}
% Neutral information.
\lrssntheme@color{LrssnInfo}{00629C}{7FCBE6}

% Hearth is for PDFs read on a screen: a dark page with light text.
% Shore is the default, because paper is light.
\iflrssntheme@hearth
    \pagecolor{LrssnBackground}
    \AtBeginDocument{\color{LrssnText}}
\fi

% Code listings.
\iflrssntheme@listings
    \RequirePackage{listings}
    \lstdefinestyle{lrssntheme}{
        basicstyle=\ttfamily\small\color{LrssnText},
        backgroundcolor=\color{LrssnCode},
        keywordstyle=\color{LrssnKeyword}\bfseries,
        keywordstyle=[2]\color{LrssnType},
        keywordstyle=[3]\color{LrssnBuiltin},
        commentstyle=\color{LrssnComment}\itshape,
        stringstyle=\color{LrssnString},
        showstringspaces=false,
        numbers=left,
        numberstyle=\tiny\color{LrssnComment},
        frame=single,
        rulecolor=\color{LrssnRule},
        breaklines=true,
        tabsize=4,
    }
    \lstset{style=lrssntheme}
\fi

\endinput
