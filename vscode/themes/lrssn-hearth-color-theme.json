  "tokenColors": [
    {
      "name": "Comments: the frost outside",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#8796aa", "fontStyle": "italic" }
    },
    {
      "name": "Keywords: the fire",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#fc6600" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "storage.type.function.arrow",
        "punctuation.separator.key-value",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#f09a62" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#a8998b" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": { "foreground": "#a9d48f" }
    },
    {
      "name": "Escapes, placeholders and regular expressions",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.character.format.placeholder"
      ],
      "settings": { "foreground": "#ffe08a" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.character",
        "constant.other.color",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#ff88c8" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
