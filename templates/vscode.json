  "tokenColors": [
    {
      "name": "Comments: the frost outside",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{ comment }}", "fontStyle": "italic" }
    },
    {
      "name": "Keywords: the fire",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "{{ keyword }}" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "storage.type.function.arrow",
        "punctuation.separator.key-value",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "{{ operator }}" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "{{ punctuation }}" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": { "foreground": "{{ string }}" }
    },
    {
      "name": "Escapes, placeholders and regular expressions",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.character.format.placeholder"
      ],
      "settings": { "foreground": "{{ escape }}" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.character",
        "constant.other.color",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "{{ number }}" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.function.member",
        "entity.other.attribute-name.class.css"
      ],
      "settings": { "foreground": "{{ function }}" }
    },
    {
      "name": "Types and classes: the ice",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "storage.type.java",
        "storage.type.cs",
        "storage.type.c",
        "storage.type.rust",
        "storage.type.go",
        "storage.type.haskell",
        "entity.name.type.parameter"
      ],
      "settings": { "foreground": "{{ type }}" }
    },
    {
      "name": "Built-ins, namespaces and decorators",
      "scope": [
        "variable.language",
        "support.variable",
        "support.function.builtin",
        "support.function.builtin.python",
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "entity.name.scope-resolution",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": { "foreground": "{{ builtin }}" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "{{ fg }}" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter", "variable.parameter.function"],
      "settings": { "foreground": "{{ parameter }}", "fontStyle": "italic" }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "support.type.property-name.css",
        "entity.name.tag.yaml",
        "entity.other.attribute-name",
        "entity.name.label"
      ],
      "settings": { "foreground": "{{ property }}" }
    },
    {
      "name": "Tags: the embers",
      "scope": ["entity.name.tag", "entity.other.attribute-name.id.css", "support.class.component"],
      "settings": { "foreground": "{{ tag }}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{ error }}" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "{{ warning }}", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup: headings",
      "scope": ["markup.heading", "entity.name.section", "markup.heading entity.name"],
      "settings": { "foreground": "{{ keyword }}", "fontStyle": "bold" }
    },
    {
      "name": "Markup: bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "{{ fg-bright }}", "fontStyle": "bold" }
    },
    {
      "name": "Markup: italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup: strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup: links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link.inline.markdown string.other.link.title"],
      "settings": { "foreground": "{{ info }}", "fontStyle": "underline" }
    },
    {
      "name": "Markup: quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{ comment }}", "fontStyle": "italic" }
    },
    {
      "name": "Markup: lists",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list punctuation.definition.list"],
      "settings": { "foreground": "{{ keyword }}" }
    },
    {
      "name": "Diff: inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "{{ added }}" }
    },
    {
      "name": "Diff: deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "{{ removed }}" }
    },
    {
      "name": "Diff: changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "{{ changed }}" }
    },
    {
      "name": "Diff: ranges",
      "scope": ["meta.diff.range", "meta.diff.header"],
      "settings": { "foreground": "{{ builtin }}" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "{{ comment }}", "italic": true },
    "keyword": "{{ keyword }}",
    "string": "{{ string }}",
    "number": "{{ number }}",
    "regexp": "{{ escape }}",
    "operator": "{{ operator }}",
    "namespace": "{{ builtin }}",
    "type": "{{ type }}",
    "class": "{{ type }}",
    "enum": "{{ type }}",
    "interface": "{{ type }}",
    "struct": "{{ type }}",
    "typeParameter": { "foreground": "{{ type }}", "italic": true },
    "parameter": { "foreground": "{{ parameter }}", "italic": true },
    "variable": "{{ fg }}",
    "variable.defaultLibrary": "{{ builtin }}",
    "property": "{{ property }}",
    "enumMember": "{{ number }}",
    "event": "{{ tag }}",
    "function": "{{ function }}",
    "method": "{{ function }}",
    "macro": "{{ builtin }}",
    "decorator": "{{ builtin }}",
    "label": "{{ property }}",
    "selfKeyword": "{{ builtin }}",
    "builtinType": "{{ type }}",
    "*.deprecated": { "strikethrough": true }
  }
}
