% Lrssn Shore and Lrssn Hearth for LaTeX.
% Generated by scripts/build.py from palette/. Do not edit.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lrssntheme}[2026-10-23 v1.0.0 Lrssn Shore and Hearth colours]

% Options.
\newif\iflrssntheme@hearth
\DeclareOption{shore}{\lrssntheme@hearthfalse}
\DeclareOption{hearth}{\lrssntheme@hearthtrue}
\newif\iflrssntheme@listings
\lrssntheme@listingstrue
\DeclareOption{nolistings}{\lrssntheme@listingsfalse}
\ProcessOptions\relax

% Dependencies.
\RequirePackage{xcolor}

% Defines a colour from its HEX value in Shore (#2) and in Hearth (#3).
\newcommand*{\lrssntheme@color}[3]{%
    \iflrssntheme@hearth
        \definecolor{#1}{HTML}{#3}%
    \else
        \definecolor{#1}{HTML}{#2}%
    \fi
}

% The page.
\lrssntheme@color{LrssnBackground}{{{ shore.bg | nohash | upper }}}{{{ hearth.bg | nohash | upper }}}
% Boxes and panels.
\lrssntheme@color{LrssnSurface}{{{ shore.bg-dim | nohash | upper }}}{{{ hearth.bg-dim | nohash | upper }}}
% Behind code.
\lrssntheme@color{LrssnCode}{{{ shore.bg-line | nohash | upper }}}{{{ hearth.bg-line | nohash | upper }}}
% Rules and frames.
\lrssntheme@color{LrssnRule}{{{ shore.border | nohash | upper }}}{{{ hearth.border | nohash | upper }}}
% Text.
\lrssntheme@color{LrssnText}{{{ shore.fg | nohash | upper }}}{{{ hearth.fg | nohash | upper }}}
% Secondary text, such as captions.
\lrssntheme@color{LrssnMuted}{{{ shore.fg-muted | nohash | upper }}}{{{ hearth.fg-muted | nohash | upper }}}
% Comments and line numbers in code.
\lrssntheme@color{LrssnComment}{{{ shore.comment | nohash | upper }}}{{{ hearth.comment | nohash | upper }}}
% The brand orange: fills and rules, never text.
\lrssntheme@color{LrssnPrimary}{{{ shore.primary | nohash | upper }}}{{{ hearth.primary | nohash | upper }}}
% Orange text and links.
\lrssntheme@color{LrssnPrimaryText}{{{ shore.primary-text | nohash | upper }}}{{{ hearth.primary-text | nohash | upper }}}
% A tint behind highlighted text.
\lrssntheme@color{LrssnPrimarySoft}{{{ shore.primary-soft | nohash | upper }}}{{{ hearth.primary-soft | nohash | upper }}}
% Text on an orange fill.
\lrssntheme@color{LrssnOnPrimary}{{{ shore.on-primary | nohash | upper }}}{{{ hearth.on-primary | nohash | upper }}}
% The cool accent: fills and rules, never text.
\lrssntheme@color{LrssnSecondary}{{{ shore.secondary | nohash | upper }}}{{{ hearth.secondary | nohash | upper }}}
% Text in the cool accent.
\lrssntheme@color{LrssnSecondaryText}{{{ shore.secondary-text | nohash | upper }}}{{{ hearth.secondary-text | nohash | upper }}}
% A tint behind secondary text.
\lrssntheme@color{LrssnSecondarySoft}{{{ shore.secondary-soft | nohash | upper }}}{{{ hearth.secondary-soft | nohash | upper }}}
% Keywords in code.
\lrssntheme@color{LrssnKeyword}{{{ shore.keyword | nohash | upper }}}{{{ hearth.keyword | nohash | upper }}}
% Functions in code.
\lrssntheme@color{LrssnFunction}{{{ shore.function | nohash | upper }}}{{{ hearth.function | nohash | upper }}}
% Strings in code.
\lrssntheme@color{LrssnString}{{{ shore.string | nohash | upper }}}{{{ hearth.string | nohash | upper }}}
% Numbers and constants in code.
\lrssntheme@color{LrssnNumber}{{{ shore.number | nohash | upper }}}{{{ hearth.number | nohash | upper }}}
% Types in code.
\lrssntheme@color{LrssnType}{{{ shore.type | nohash | upper }}}{{{ hearth.type | nohash | upper }}}
% Built-ins in code.
\lrssntheme@color{LrssnBuiltin}{{{ shore.builtin | nohash | upper }}}{{{ hearth.builtin | nohash | upper }}}
% Errors and danger.
\lrssntheme@color{LrssnError}{{{ shore.error | nohash | upper }}}{{{ hearth.error | nohash | upper }}}
% Warnings.
\lrssntheme@color{LrssnWarning}{{{ shore.warning | nohash | upper }}}{{{ hearth.warning | nohash | upper }}}
% Success.
\lrssntheme@color{LrssnSuccess}{{{ shore.success | nohash | upper }}}{{{ hearth.success | nohash | upper }}}
% Neutral information.
\lrssntheme@color{LrssnInfo}{{{ shore.info | nohash | upper }}}{{{ hearth.info | nohash | upper }}}

% Hearth is for PDFs read on a screen: a dark page with light text.
% Shore is the default, because paper is light.
\iflrssntheme@hearth
    \pagecolor{LrssnBackground}
    \AtBeginDocument{\color{LrssnText}}
\fi

% Code listings.
\iflrssntheme@listings
    \RequirePackage{listings}
    \lstdefinestyle{lrssntheme}{
        basicstyle=\ttfamily\small\color{LrssnText},
        backgroundcolor=\color{LrssnCode},
        keywordstyle=\color{LrssnKeyword}\bfseries,
        keywordstyle=[2]\color{LrssnType},
        keywordstyle=[3]\color{LrssnBuiltin},
        commentstyle=\color{LrssnComment}\itshape,
        stringstyle=\color{LrssnString},
        showstringspaces=false,
        numbers=left,
        numberstyle=\tiny\color{LrssnComment},
        frame=single,
        rulecolor=\color{LrssnRule},
        breaklines=true,
        tabsize=4,
    }
    \lstset{style=lrssntheme}
\fi

\endinput
