# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 80

# The formats that editors, Neovim and the terminals expect at two spaces.
[*.{json,lua,html,yml}]
indent_size = 2
max_line_length = off

# The website's stylesheet and iTerm2's plists use tabs.
[*.{scss,itermcolors}]
indent_style = tab

[*.md]
max_line_length = off
